name   = DeskBound Title
artist = KeeTraxx
tempo  = 3

# --- Sections -------------------------------------------------------------

# Synth hook, 75% pulse with vibrato. Each bar: Fm | Cm, then Eb | Bb.
&hook    = 10 | f5 . eb5 c5 . . ab4 c5 eb5 . c5 g4 . . ~ ~ | g5 . f5 eb5 . . bb4 eb5 f5 . d5 bb4 . . ~ ~
# The same shape, pitched higher for the chorus.
&hook_hi = 10 | c6 . bb5 ab5 . . f5 ab5 g5 . eb5 c5 . . ~ c5 | bb5 . ab5 g5 . . eb5 g5 f5 . d5 bb4 . . . .
# Sparser verse line on a decaying pulse.
&verse   = 2  | c5 . ab4 . c5 . . . bb4 . g4 . eb4 . . . | bb4 . g4 . bb4 . . . f4 . d4 . bb4 . . .

# Sixteenth-note chord arpeggios.
&arp     = 5  | [f4 ab4 c5 ab4]*4 [c4 eb4 g4 eb4]*4 | [eb4 g4 bb4 g4]*4 [d4 f4 bb4 f4]*4

# Saw bass: held roots for the intro, then eighth-note octave bounce.
&bass_in = 13 | f2 c2 | eb2 bb2
&bass    = 13 | [f2 f3]*4 [c2 c3]*4 | [eb2 eb3]*4 [bb2 bb3]*4

# Drums. One instrument per bar, so hats and snare take turns by section.
&hats    = 1  | c6*16
&beat    = 7  | ~ c5 ~ c5 ~ c5 ~ c5

&rest    = ~

# --- Arrangement: intro 4, verse 4, chorus 4, outro 4 --------------------

pulse1 = &hook*2 &verse*2 &hook_hi*2 &hook*2
pulse2 = 5 | &rest*4 &arp*6
wave   = &bass_in*2 &bass*6
noise  = &hats*8 &beat*8
