# Coffee Break — a cheerful jazz loop in F.
# Instrument numbers index the .uge template's banks (1-15 per channel).

name   = Coffee Break
artist = gb-strudel
tempo  = 2

# Lead: 50% pulse, syncopated melody over the changes.
pulse1 = 8 | c4 ~ a3 c4 | d4 ~ c4 ~ | as3 d4 c4 as3 | a3 ~ g3 ~

# Comping: thin pulse on the off-beats, guide tones only.
pulse2 = 6 | ~ e3 ~ a2 | ~ f3 ~ c3 | ~ f3 ~ as2 | ~ e3 ~ as2

# Walking bass on the wave channel.
wave   = 4 | f2 a2 c3 e3 | d3 c3 a2 f2 | g2 as2 d3 f3 | e3 d3 c3 as2

# Ride pattern with a backbeat.
noise  = 1 | c4*4 | c4 ~ c4 c4 | c4*4 | c4 c4 c4 c4
